// Two versions of one table, for testing schema evolution. Evolution rules: a field keeps its
// ID and type forever; new fields are appended; a field that is no longer used is deprecated.
namespace gendb.tests.evolution;

table AccountV1 {
  id: ulong;
  name: string;
  nickname: string;
  age: int;
}

table AccountV2 {
  id: ulong;
  name: string;
  nickname: string (deprecated);
  age: int (deprecated);
  email: string;
  score: double;
  vip: bool;
}
