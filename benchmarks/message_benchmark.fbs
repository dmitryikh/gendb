namespace gendb.benchmarks.flat;

table Account {
  account_id: ulong = null;
  trader_id: string;
  name: string;
  address: string;
  age: int = null;
  is_active: bool = null;
  balance: float = null;
  config_name: string;
}

table Position {
  position_id: int = null;
  account_id: int = null;
  volume: int = null;
  instrument: string;
  open_price: float = null;
  direction: uint = null;
}

